{
  "name": "WF08: eTIMS Submission Queue (Manual Mode)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "schedule-hourly",
      "name": "Hourly Queue Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/automations/tax/etims-queue",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.PAYOPS_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 5000
        }
      },
      "id": "http-etims-queue",
      "name": "Check eTIMS Manual Queue in Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/automations/alerts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.PAYOPS_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "workflow_id",
              "value": "WF08"
            },
            {
              "name": "error_message",
              "value": "={{$json.message || 'eTIMS submission queue processor failed'}}"
            },
            {
              "name": "attempt_count",
              "value": 3
            }
          ]
        }
      },
      "id": "alert-on-failure",
      "name": "Alert on Final Failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 420]
    }
  ],
  "connections": {
    "Hourly Queue Check": {
      "main": [
        [
          {
            "node": "Check eTIMS Manual Queue in Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Check eTIMS Manual Queue in Backend": {
      "main": [
        [],
        [
          {
            "node": "Alert on Final Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
