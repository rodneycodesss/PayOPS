{
  "name": "WF10: Customer Invoice Delivery",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "invoice-issued-event",
        "options": {}
      },
      "id": "webhook-invoice-issued",
      "name": "Invoice Issued Event Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/automations/invoices/delivery",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.PAYOPS_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({ invoice_id: $json.body.invoice_id, recipient_email: $json.body.recipient_email })}}",
        "options": {
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 3000
        }
      },
      "id": "http-deliver-invoice",
      "name": "Dispatch Invoice Email via Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/automations/alerts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.PAYOPS_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "workflow_id",
              "value": "WF10"
            },
            {
              "name": "error_message",
              "value": "={{$json.message || 'Invoice delivery email failed after retries'}}"
            },
            {
              "name": "attempt_count",
              "value": 3
            }
          ]
        }
      },
      "id": "alert-on-failure",
      "name": "Alert on Final Failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 420]
    }
  ],
  "connections": {
    "Invoice Issued Event Webhook": {
      "main": [
        [
          {
            "node": "Dispatch Invoice Email via Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatch Invoice Email via Backend": {
      "main": [
        [],
        [
          {
            "node": "Alert on Final Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
