{
  "name": "WF02: STK Push Initiation",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "initiate-stk",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Incoming STK Trigger Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/automations/stk-push",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.PAYOPS_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{JSON.stringify({ phone_number: $json.body.phone_number, amount: $json.body.amount, account_reference: $json.body.account_reference })}}",
        "options": {
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 3000
        }
      },
      "id": "http-stk-push",
      "name": "Dispatch STK Push via Backend API",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/automations/alerts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.PAYOPS_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "workflow_id",
              "value": "WF02"
            },
            {
              "name": "error_message",
              "value": "={{$json.message || 'STK Push dispatch failed after retries'}}"
            },
            {
              "name": "attempt_count",
              "value": 3
            }
          ]
        }
      },
      "id": "alert-on-failure",
      "name": "Alert on Final Failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 420]
    }
  ],
  "connections": {
    "Incoming STK Trigger Webhook": {
      "main": [
        [
          {
            "node": "Dispatch STK Push via Backend API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatch STK Push via Backend API": {
      "main": [
        [],
        [
          {
            "node": "Alert on Final Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
