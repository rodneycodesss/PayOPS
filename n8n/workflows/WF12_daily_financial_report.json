{
  "name": "WF12: Daily Financial Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 7 * * *"
            }
          ]
        }
      },
      "id": "cron-daily-7am",
      "name": "Trigger Daily at 07:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "http://backend:8000/api/v1/automations/reports/daily-summary",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.PAYOPS_API_KEY}}"
            }
          ]
        },
        "options": {
          "retryOnFail": true,
          "maxTries": 3
        }
      },
      "id": "http-get-summary",
      "name": "Fetch Daily Financial Summary from Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300]
    },
    {
      "parameters": {
        "fromEmail": "reports@rodstartechdevs.co.ke",
        "toEmail": "={{$env.EXECUTIVE_REPORT_EMAIL || 'rodney@rodstartechdevs.co.ke'}}",
        "subject": "=Rodstar PayOps: Daily Collections & Settlement Briefing ({{$json.date}})",
        "text": "=Good morning,\n\nHere is your daily executive financial brief:\n\n- Collections Today: {{$json.collections_today}}\n- M-PESA Total: {{$json.mpesa_total}}\n- Bank Settlements: {{$json.bank_total}}\n- Auto-Reconciled: {{$json.reconciled_percentage}}\n- Open Exceptions: {{$json.unmatched_exceptions}}\n- eTIMS Mode: {{$json.etims_status}}\n\nGenerated by Rodstar PayOps Automation Engine."
      },
      "id": "send-executive-email",
      "name": "Send Executive Briefing Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [680, 300]
    }
  ],
  "connections": {
    "Trigger Daily at 07:00 UTC": {
      "main": [
        [
          {
            "node": "Fetch Daily Financial Summary from Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Fetch Daily Financial Summary from Backend": {
      "main": [
        [
          {
            "node": "Send Executive Briefing Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
