{
  "name": "WF11: Payment Reminders",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 8 * * 1"
            }
          ]
        }
      },
      "id": "cron-weekly-monday",
      "name": "Trigger Every Monday at 08:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/automations/invoices/reminders",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.PAYOPS_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 5000
        }
      },
      "id": "http-dispatch-reminders",
      "name": "Trigger Overdue Invoices Reminders in Backend",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/automations/alerts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.PAYOPS_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "workflow_id",
              "value": "WF11"
            },
            {
              "name": "error_message",
              "value": "={{$json.message || 'Payment reminders job failed'}}"
            },
            {
              "name": "attempt_count",
              "value": 3
            }
          ]
        }
      },
      "id": "alert-on-failure",
      "name": "Alert on Final Failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 420]
    }
  ],
  "connections": {
    "Trigger Every Monday at 08:00 UTC": {
      "main": [
        [
          {
            "node": "Trigger Overdue Invoices Reminders in Backend",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Trigger Overdue Invoices Reminders in Backend": {
      "main": [
        [],
        [
          {
            "node": "Alert on Final Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
