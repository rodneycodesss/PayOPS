{
  "name": "WF04: Invoice Auto-Reconciliation",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 2 * * *"
            }
          ]
        }
      },
      "id": "cron-daily-2am",
      "name": "Trigger Daily at 02:00 UTC",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/automations/reconciliation/run",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.PAYOPS_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "options": {
          "retryOnFail": true,
          "maxTries": 3,
          "waitBetweenTries": 10000
        }
      },
      "id": "http-run-reconciliation",
      "name": "Run Multi-Tier Matching Engine",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 300],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://backend:8000/api/v1/automations/alerts",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{$env.PAYOPS_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "workflow_id",
              "value": "WF04"
            },
            {
              "name": "error_message",
              "value": "={{$json.message || 'Invoice Auto-Reconciliation failed on scheduled run'}}"
            },
            {
              "name": "attempt_count",
              "value": 3
            }
          ]
        }
      },
      "id": "alert-on-failure",
      "name": "Alert on Final Failure",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [700, 420]
    }
  ],
  "connections": {
    "Trigger Daily at 02:00 UTC": {
      "main": [
        [
          {
            "node": "Run Multi-Tier Matching Engine",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Run Multi-Tier Matching Engine": {
      "main": [
        [],
        [
          {
            "node": "Alert on Final Failure",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
