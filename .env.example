# ==============================================================================
# Rodstar PayOps: Environment Configuration Template
# Target Domain: payops.rodstartechdevs.co.ke
# ==============================================================================

# Application Environment
APP_NAME="Rodstar PayOps"
APP_ENV=production
DEBUG=false
DOMAIN=payops.rodstartechdevs.co.ke

# Security & Secrets
# Generate random 64-char hex string: `openssl rand -hex 32`
SECRET_KEY=replace-with-ultra-secure-random-secret-key-in-production

# Fernet Master Encryption Key for Provider Credentials at Rest
# Generate with Python: `python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
CREDENTIALS_ENCRYPTION_KEY=Wb0T3r_G3Z1Zf1fWj_Wz2X4y6z8A0b1C2d3E4F5g6H8=

# JWT Expiration Policy
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL Database Configuration
POSTGRES_USER=payops_user
POSTGRES_PASSWORD=replace-with-strong-db-password
POSTGRES_DB=rodstar_payops
POSTGRES_HOST=db
POSTGRES_PORT=5432

DATABASE_URL=postgresql+asyncpg://payops_user:replace-with-strong-db-password@db:5432/rodstar_payops
DATABASE_URL_SYNC=postgresql+psycopg2://payops_user:replace-with-strong-db-password@db:5432/rodstar_payops

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Email / SMTP Notification Settings
SMTP_HOST=smtp.mailgun.org
SMTP_PORT=587
SMTP_USER=postmaster@rodstartechdevs.co.ke
SMTP_PASSWORD=replace-with-smtp-api-key
SMTP_TLS=true
EMAIL_FROM=notifications@rodstartechdevs.co.ke
EMAIL_FROM_NAME="Rodstar PayOps"

# Daraja M-PESA Default Configuration (Fallback / Sandbox)
DARAJA_SANDBOX_SHORTCODE=174379

# Base Currency
DEFAULT_CURRENCY=KES
